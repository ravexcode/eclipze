# Prisma
# Default provider configured in prisma/schema.prisma: postgresql
DATABASE_URL=postgresql://user:password@localhost:5432/eclipse

# Email auth with Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
AUTH_EMAIL_NO_REPLY_FROM=Eclipse <no-reply@your-domain.com>
AUTH_EMAIL_REPLY_TO=support@your-domain.com

# Optional fallback / general sender
AUTH_EMAIL_FROM=Eclipse <auth@your-domain.com>

# OAuth providers (Google redirect URI: $APP_URL/api/auth/google/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Application URL
APP_URL=http://localhost:8080

# CACHE KEYS
NEXT_PUBLIC_CRYPTO_SECRET_KEY=

# Server-side encryption for user AI provider keys
AI_CREDENTIALS_ENCRYPTION_KEY=

# Optional Eclipse-funded OpenRouter connection for monthly AI credits
OPENROUTER_API_KEY=

# App settings
NEXT_PUBLIC_API_KEY=

# Stripe billing (webhook endpoint: $APP_URL/api/billing/webhook)
# Set STRIPE_SECRET_KEY, then run `pnpm stripe:setup` to create the prices, portal, and webhook
# For local development, run `pnpm stripe:webhook`, then put the `whsec_...` secret it
# prints in .env.local as STRIPE_WEBHOOK_SECRET and restart the dev server
STRIPE_SECRET_KEY=
# Loads Stripe.js for the in-app checkout; served to the browser at runtime
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly recurring USD prices, tax inclusive
STRIPE_PRICE_PLUS=
STRIPE_PRICE_MAX=
# Reserved for the Enterprise plan (coming soon)
STRIPE_PRICE_TEAM=
# Optional customer portal configuration; the account default is used when empty
STRIPE_PORTAL_CONFIGURATION_ID=
